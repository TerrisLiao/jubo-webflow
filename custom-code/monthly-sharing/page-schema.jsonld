      "mainEntity": [
        {
          "@type": "Question",
          "name": "需要報名或付費嗎？",
          "acceptedAnswer": { "@type": "Answer", "text": "不用。直播在智齡科技 YouTube 頻道公開播出，打開連結就能看。" }
        },
        {
          "@type": "Question",
          "name": "怎麼收到開播提醒？",
          "acceptedAnswer": { "@type": "Answer", "text": "加入智齡科技 LINE 官方帳號，就能收到新集數資訊與開播提醒。也可以訂閱智齡科技 YouTube 頻道，開啟小鈴鐺通知。" }
        },
        {
          "@type": "Question",
          "name": "錯過直播怎麼辦？",
          "acceptedAnswer": { "@type": "Answer", "text": "每一集都會保留回放，整理在上方「過去直播」和 YouTube 播放清單，隨時可以回來複習。" }
        },
        {
          "@type": "Question",
          "name": "簡報可以下載嗎？",
          "acceptedAnswer": { "@type": "Answer", "text": "經講師同意公開的簡報，填寫課後問卷後即可下載。問卷連結會在直播最後提供，完成並送出問卷後，就能下載該集簡報。" }
        },
        {
          "@type": "Question",
          "name": "想推薦主題或講師？",
          "acceptedAnswer": { "@type": "Answer", "text": "主題每半年規劃一次。歡迎在 LINE 官方帳號留言告訴我們，你最近遇到的問題可能就是下一集的題目。" }
        }
      ]
