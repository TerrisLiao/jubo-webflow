{
  "name": "jubo-a11y-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "jubo-health.com 無障礙稽核腳本。只讀線上已發布的 HTML，不會碰 Webflow API。",
  "scripts": {
    "fetch": "bash fetch-pages.sh _work",
