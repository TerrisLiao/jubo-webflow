    "score": "cd _work && node ../score.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.63.0"
  }
}
